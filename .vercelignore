# Vercel does not descend into nested .gitignore files, so omen-agent's own
# ignores (node_modules, .eve) are not applied to a CLI upload. Without this
# the tree is ~2.3 GB against a 10 MB request limit; the tracked source is 2.3 MB.
node_modules
omen-agent/node_modules
omen-agent/.eve
omen-agent/.vercel
omen-agent/.output
.next
.git
.env*
*.tsbuildinfo
.DS_Store
